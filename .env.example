# Copy to .env and edit. .env is gitignored.

CONDA_ENV=scope
CONDA_ENV_WEBSHOP=scope-webshop
# Set this only if conda envs live in a fixed prefix directory.
# CONDA_ENV_BIN_ROOT=/path/to/conda/envs

# Local model directories. Hugging Face ids also work.
# MODELS_ROOT=./models
# MODEL_PATH=Qwen/Qwen2.5-3B-Instruct
# MODEL_PATH_QWEN3=Qwen/Qwen3-1.7B

DATA_ROOT=./data
ALFWORLD_DATA=./data/alfworld

# SCOPE_BASE_3B=Qwen/Qwen2.5-3B-Instruct
# SCOPE_BASE_7B=Qwen/Qwen2.5-7B-Instruct
# SCOPE_BASE_QWEN3=Qwen/Qwen3-1.7B
# SCOPE_SFT_ROOT=./work/ckpt/sft/scope
# SCOPE_SAMPLE_ROOT=./work/rollouts/scope
# SCOPE_WORK_ROOT=./work

# SwanLab. Use local mode if you do not want a cloud key.
SWANLAB_MODE=local
# SWANLAB_API_KEY=
# SWANLAB_LOG_DIR=./logs/swanlab

# Ray AF_UNIX sockets must stay under 107 bytes.
# RAY_TMPDIR=/tmp/scope-ray
